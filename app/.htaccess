RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

RewriteRule ^agendamento(.*)$ agendamentos.php [L]
RewriteRule ^agendamentos(.*)$ agendamentos.php [L]
RewriteRule ^produtos(.*)$ produtos.php [L]
RewriteRule ^servicos(.*)$ servicos.php [L]
RewriteRule ^index(.*)$ index.php [L]
RewriteRule ^index.php(.*)$ index.php [L]
RewriteRule ^home(.*)$ home.php [L]
RewriteRule ^assinatura(.*)$ assinatura.php [L]
RewriteRule ^sistema/acesso(.*)$ sistema/acesso.php [L]
RewriteRule ^barbearia(.*)$ barbearia.php [L]
RewriteRule ^corte-cabelo(.*)$ corte-cabelo.php [L]
RewriteRule ^protese(.*)$ protese.php [L]
RewriteRule ^home(.*)$ home.php [L]
RewriteRule ^bio(.*)$ bio.php [L]


RewriteRule ^pagar_asaas/(.*)$ asaas/index.php?id_conta=$1 [L]
RewriteRule ^pagamento_asaas/(.*)/(.*)$ asaas/index.php?id_conta=$1&total=$2 [L]
RewriteRule ^plano_asaas/(.*)$ asaas_planos/index.php?id_conta=$1 [L]
RewriteRule ^conta_asaas/(.*)$ asaas_contas/index.php?id_conta=$1 [L]


RewriteRule ^pagar/(.*)$ pagamentos/index.php?id_conta=$1 [L]
RewriteRule ^pagamento/(.*)/(.*)$ pagamentos/index.php?id_conta=$1&total=$2 [L]
RewriteRule ^plano/(.*)$ pagamentos/pagar.php?id_conta=$1 [L]
RewriteRule ^conta/(.*)$ pagamentos/receber.php?id_conta=$1 [L]
# ============================================
# ⚡ OTIMIZAÇÕES ADICIONADAS (100% SEGURAS)
# ============================================

# --- COMPRESSÃO BROTLI (se disponível) ---
<IfModule mod_brotli.c>
  BrotliCompressionQuality 5
  AddOutputFilterByType BROTLI_COMPRESS text/plain text/html text/xml text/css application/json application/javascript application/x-javascript image/svg+xml
</IfModule>

# --- COMPRESSÃO GZIP (fallback se Brotli indisponível) ---
<IfModule mod_deflate.c>
  # Evita dupla compressão quando Brotli já está ativo
  <IfModule !mod_brotli.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
  </IfModule>
</IfModule>

# --- CACHE DE IMAGENS/CSS/JS (extra) ---
<IfModule mod_expires.c>
  ExpiresActive On

  # Imagens (1 ano)
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/jpg  "access plus 1 year"
  ExpiresByType image/png  "access plus 1 year"
  ExpiresByType image/gif  "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  # SVG costuma mudar mais
  ExpiresByType image/svg+xml "access plus 1 month"

  # CSS e JavaScript (1 mês)
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# --- HEADERS BÁSICOS ---
<IfModule mod_headers.c>
  # Cache-Control específico para imagens
  <FilesMatch "\.(?:jpg|jpeg|png|gif|webp)$">
    Header set Cache-Control "max-age=31536000, public"
  </FilesMatch>

  # Segurança básica
  Header set X-Content-Type-Options "nosniff"
</IfModule>


# ============================================
# CONFIGURAÇÕES ORIGINAIS (MANTIDAS 100%)
# ============================================

# TIPOS MIME (MANTIDOS)
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/svg+xml .svg .svgz
  AddType image/x-icon .ico
  AddType font/woff .woff
  AddType font/woff2 .woff2
  AddType font/ttf .ttf
  AddType font/otf .otf
  AddType application/vnd.ms-fontobject .eot
  AddType video/mp4 .mp4
  AddType video/webm .webm
  AddType video/ogg .ogv
  AddType application/javascript .js
  AddType text/javascript .js
  AddType application/json .json
  AddType application/manifest+json .webmanifest
</IfModule>

# CACHE ESTÁTICO ORIGINAL (MANTIDO)
<IfModule mod_expires.c>
  ExpiresDefault "access plus 1 month"

  # Fontes (1 ano)
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  ExpiresByType application/vnd.ms-fontobject "access plus 1 year"

  # Vídeos (1 ano)
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType video/webm "access plus 1 year"
  ExpiresByType video/ogg "access plus 1 year"

  # HTML (1 hora)
  ExpiresByType text/html "access plus 1 hour"

  # Dados (1 semana)
  ExpiresByType application/json "access plus 1 week"
  ExpiresByType application/xml  "access plus 1 week"
  ExpiresByType text/xml         "access plus 1 week"
</IfModule>

# CACHE-CONTROL HEADERS (MANTIDO)
<IfModule mod_headers.c>
  # Fontes (1 ano, immutable + CORS)
  <FilesMatch "\.(?:woff|woff2|ttf|otf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>

  # HTML/PHP (sem cache)
  <FilesMatch "\.(?:html?|php)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Remover ETags
  Header unset ETag
  FileETag None

  # HEADERS DE SEGURANÇA
  Header always set X-XSS-Protection "1; mode=block"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

  # Vary header para cache correto
  <FilesMatch "\.(?:js|css|xml|gz|html?)$">
    Header append Vary Accept-Encoding
  </FilesMatch>
</IfModule>

# SEGURANÇA ADICIONAL (MANTIDA)
<FilesMatch "\.(?:sql|env|log|ini|config|yml|yaml|bak|backup|old|orig|save|swp|tmp)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Proteger arquivos ocultos
<FilesMatch "^\.(?!well-known)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Proteção do próprio .htaccess
<Files ".htaccess">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</Files>

# OTIMIZAÇÕES PHP (MANTIDAS)
<IfModule mod_php.c>
  php_value upload_max_filesize 10M
  php_value post_max_size 10M
  php_value max_execution_time 60
  php_value max_input_time 60
  php_value memory_limit 256M
  php_value opcache.enable 1
  php_value opcache.memory_consumption 128
  php_value opcache.max_accelerated_files 10000
  php_value opcache.revalidate_freq 2
</IfModule>

# ============================================
# FIM DO ARQUIVO
# ============================================

# RESUMO:
# - Rotas: mantidas 100%
# - Original: mantido 100%
# - Adições seguras: Brotli/Gzip (sem dupla compressão), cache extra e headers básicos

# php -- BEGIN cPanel-generated handler, do not edit
# Defina o pacote “ea-php81” como a linguagem padrão de programação “PHP”.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php81 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
