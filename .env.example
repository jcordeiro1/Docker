# Porta local usada para acessar o BarberBot
APP_PORT=8080
APP_URL=http://localhost:8080
APP_NAME=BarberBot Docker Demo
APP_CONTACT_EMAIL=contato@example.test
APP_CONTACT_WHATSAPP=

# Banco MySQL - valores fictícios para o trabalho acadêmico
DB_HOST=db
DB_PORT=3306
DB_NAME=barber
DB_USER=barber_user
DB_PASSWORD=barber_demo_password
DB_ROOT_PASSWORD=root_demo_password

# Usuário de demonstração criado ao abrir /sistema pela primeira vez
DEMO_ADMIN_NAME=Administrador Demo
DEMO_ADMIN_EMAIL=admin@example.test
DEMO_ADMIN_PASSWORD=demo123

# Integrações opcionais - deixe vazio no ambiente acadêmico
OPENAI_API_KEY=
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
GOOGLE_MAPS_API_KEY=

MERCADO_PAGO_ACCESS_TOKEN=
